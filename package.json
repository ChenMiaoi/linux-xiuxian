{
  "name": "linux-xiuxian",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "check:commit-msg": "node scripts/validate-commit-msg.mjs",
    "dev": "npx tsx scripts/build-playground.ts && vitepress dev docs --host",
    "dev:site": "vitepress dev docs --host",
    "build": "npx tsx scripts/build-playground.ts && vitepress build docs",
    "build:site": "vitepress build docs",
    "build:playground": "npx tsx scripts/build-playground.ts",
    "preview": "vitepress preview docs"
  },
  "devDependencies": {
    "vitepress": "^1.6.0",
    "vue": "^3.5.0"
  }
}
